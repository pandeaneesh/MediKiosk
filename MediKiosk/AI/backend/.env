# ==============================================================================
# MediKiosk Conversational AI - Environment Configuration (.env)
# ==============================================================================
# Copy this file or edit directly in backend/.env
# All keys below are OPTIONAL. The application is completely functional out of the box
# using high-precision deterministic clinical logic and browser Web Speech APIs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="MediKiosk Conversational AI"
VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2. Google Gemini LLM Reasoning (Optional)
# ------------------------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/
# - If provided: Enables deep LLM semantic slot extraction and nuanced query reasoning.
# - If blank (""): The kiosk uses the built-in deterministic SOCRATES & Ayurveda clinical state machines.
GEMINI_API_KEY="AQ.Ab8RN6KK3qztglSD9VtgMP-btgcqZFAzIjc7pzUoxo4l00398A"
GEMINI_MODEL="gemini-3.7-flash"

# ------------------------------------------------------------------------------
# 3. Government of India Bhashini Multilingual Speech API (Optional)
# ------------------------------------------------------------------------------
# Portal: https://bhashini.gov.in/ulca
# Used for server-side Indian language Automated Speech Recognition (ASR) & Text-to-Speech (TTS).
# - If blank (""): The frontend automatically uses the browser's native Web Speech API.
#
# Field Mapping:
# - BHASHINI_USER_ID          : Your Bhashini / ULCA Account / Udyat User ID ('userID')
# - BHASHINI_API_KEY          : Your ULCA API Key ('ulcaApiKey')
# - BHASHINI_INFERENCE_API_KEY: (Optional) Separate Bearer / Inference Authorization Key
# - BHASHINI_SERVICE_ID       : (Optional) Interface or model Service ID for ASR / TTS
# - BHASHINI_PIPELINE_ID      : (Optional) Custom Pipeline ID if assigned
# - BHASHINI_INFERENCE_URL    : Inference endpoint URL (defaults to Dhruva pipeline)
BHASHINI_USER_ID="103e08128ee9450aa5b7d22e536b4cd1"
BHASHINI_API_KEY="28f7afa7b9-12d1-471e-a29f-e919b9c8fcc9"
BHASHINI_INFERENCE_API_KEY="bHQpAP8onEEWVWt23tJi3dEF9ioShOCoTYWovRYS8604L8nb7Q-rjWOV5knLfj_d"
BHASHINI_SERVICE_ID=""
BHASHINI_PIPELINE_ID=""
BHASHINI_INFERENCE_URL="https://dhruva-api.bhashini.gov.in/services/inference/pipeline"

# ------------------------------------------------------------------------------
# 4. Hospital Triage & Emergency Escalation Webhook (Optional)
# ------------------------------------------------------------------------------
# Target URL for emergency nurse station or triage desk dispatch when red-flag
# symptoms (e.g. acute coronary syndrome, stroke, anaphylaxis) are triggered.
# Example: https://hospital.local/api/triage/emergency-alert
EMERGENCY_ALERT_WEBHOOK=""

# ------------------------------------------------------------------------------
# 5. Localization Defaults
# ------------------------------------------------------------------------------
# Default session language when kiosk starts before patient selection.
# Supported options: english, hindi, marathi, gujarati, tamil, bengali, telugu, kannada
DEFAULT_LANGUAGE="english"
